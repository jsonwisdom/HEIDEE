{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/JOY/schemas/joy/epistemic_receipt_v0_1.schema.json",
  "title": "JoySpace Epistemic Receipt v0.1",
  "description": "Machine-readable schema for a JoySpace / Wisdom Games epistemic receipt. Authority remains false. This artifact records a sequence of epistemic moves; it does not create truth, authority, legal findings, or participation status.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","receipt_type","receipt_id","timestamp","moves","sources","classifications","genesis_status","dissent_notes","result_state","authority"],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "receipt_type": {"type": "string", "const": "epistemic_receipt_v0_1"},
    "receipt_id": {"type": "string", "minLength": 8},
    "timestamp": {"type": "string", "format": "date-time"},
    "identity_label": {"type": ["string", "null"]},
    "quest_family": {"type": ["string", "null"], "enum": ["School","Money","Law","Government","Alabama_ANG","Campus",null]},
    "moves": {"type": "array", "items": {"$ref": "#/$defs/Move"}, "minItems": 1},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/Source"}},
    "classifications": {"type": "array", "items": {"$ref": "#/$defs/Classification"}},
    "genesis_status": {"type": "string", "enum": ["MATCH","DRIFT","UNKNOWN","NOT_TESTED"]},
    "dissent_notes": {"type": "array", "items": {"type": "string"}},
    "result_state": {"type": "string", "enum": ["PASS","HOLD","CONFLICT","REJECT"]},
    "replay_instructions": {"type": ["string", "null"]},
    "authority": {"type": "boolean", "const": false},
    "scoring": {"type": ["object", "null"], "properties": {"points": {"type": "integer", "minimum": 0}, "badges": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "string"}}, "additionalProperties": false}
  },
  "$defs": {
    "Move": {"type": "object", "additionalProperties": false, "required": ["code","name"], "properties": {"code": {"type": "string", "enum": ["M1","M2","M3","M4","M5","M6","M7","M8","S1","S2","S3","S4"]}, "name": {"type": "string", "enum": ["DISCOVER","CLASSIFY","TIMESTAMP","BIND","TEST_GENESIS","PRESERVE_DISSENT","REPLAY","RECEIPT","HOLD","DONT_KNOW","DISSENT","REFUSE"]}, "detail": {"type": ["string", "null"]}, "timestamp": {"type": ["string", "null"], "format": "date-time"}}},
    "Source": {"type": "object", "additionalProperties": false, "required": ["pointer"], "properties": {"pointer": {"type": "string"}, "access_note": {"type": ["string", "null"]}, "retrieved_at": {"type": ["string", "null"], "format": "date-time"}}},
    "Classification": {"type": "object", "additionalProperties": false, "required": ["label"], "properties": {"label": {"type": "string"}, "scope": {"type": ["string", "null"]}, "consent": {"type": ["string", "null"], "enum": ["CONSENT_EXPLICIT","CONSENT_IMPLIED","CONSENT_ABSENT","CONSENT_UNKNOWN",null]}}}
  }
}